types = {
	type[resource] = {
		skip_root_key = resources
		path = "game/common/resources"
	}
}

enums = {
	enum[resource] = {
		oil
		aluminium
		rubber
		tungsten
		steel
		chromium
		coal
	}
}

resource = {
	### Icon frame from file.
	icon_frame = int
	### 1 unit of resource costs this many civ factories.
	cic = float
	### This many convoys to convey one unit of resource.
	convoys = float
}